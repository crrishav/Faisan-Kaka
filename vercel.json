{
  "rewrites": [
    { "source": "/studio/static/:path*", "destination": "/studio/static/:path*" },
    { "source": "/static/:path*", "destination": "/studio/static/:path*" },
    { "source": "/studio", "destination": "/studio/index.html" },
    { "source": "/studio/:path*", "destination": "/studio/index.html" },
    { "source": "/((?!studio/|static/).*)", "destination": "/index.html" }
  ]
}
